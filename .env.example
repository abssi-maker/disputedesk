# Same keys as render.yaml. Locally: cp .env.example .env and fill in.
# On Render: set the sync:false values in the dashboard (Environment tab).

# Public URL of the app (Render URL in prod, http://localhost:3000 locally)
APP_BASE_URL=http://localhost:3000

# Gemini (agent: decisions, evidence drafts, tool calls). Key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PayPal sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered for CUSTOMER.DISPUTE.* events at <APP_BASE_URL>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Agent guardrail: disputes at or under this amount (USD) may be auto-resolved
AUTO_RESOLVE_LIMIT_USD=50

# Merchant time zone (IANA name, e.g. America/New_York). Working hours are 9-17 in this zone.
# Empty = the server's zone.
MERCHANT_TZ=

# Bryntum licensed registry token (not needed while using the trial package)
BRYNTUM_NPM_TOKEN=
